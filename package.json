{
  "name": "satspilot",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI-powered Bitcoin Lightning business assistant for small merchants",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "css:build": "npx @tailwindcss/cli@4.3.5 -i ./src/app/globals.css -o ./src/app/satspilot.css --minify",
    "prebuild": "npm run css:build",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build --webpack",
    "vercel-build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "demo": "node scripts/demo-up.js",
    "demo:down": "docker compose down"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@getalby/sdk": "^9.0.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "nostr-tools": "^2.26.1",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "websocket-polyfill": "^0.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vercel": "^39.4.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "deepmerge-ts": "8.0.1"
  }
}
