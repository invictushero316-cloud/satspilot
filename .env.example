# Application
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Database (PostgreSQL) — never commit real credentials
DATABASE_URL=postgresql://satspilot:satspilot@localhost:5432/satspilot?schema=public

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Wallet credential encryption (AES-256-GCM). Separate from AUTH_SECRET.
# 64-char hex (32 bytes) OR base64 encoding of 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=

# Demo seed (development / explicit demo only)
# ALLOW_DEMO_SEED=true
# APP_ENV=demo
# DEMO_SEED_PASSWORD=  # optional override; default is documented in README (dev only)

# AI provider (server-side only) — never expose to the browser or logs
# openai | compatible | mock | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=800
AI_MAX_INPUT_CHARS=4000


# Lightning / Nostr Wallet Connect (NIP-47) — server-side secrets only
# Provider: omit or "nwc" for real @getalby/sdk NWCClient; "mock" for labeled demo/tests ONLY.
# Hackathon Compose demo defaults to mock so settlement is reproducible without wallet credentials.
LIGHTNING_PROVIDER=nwc
NWC_RELAY_URL=

# Docker demo helpers (used by docker compose / npm run demo)
# APP_PORT=3000
# RUN_DEMO_SEED=true

# Optional default relay for receipt attestations (merchant opt-in still required)
NOSTR_RECEIPT_RELAY_URL=wss://relay.damus.io


# Docker Compose Postgres
POSTGRES_USER=satspilot
POSTGRES_PASSWORD=satspilot
POSTGRES_DB=satspilot
